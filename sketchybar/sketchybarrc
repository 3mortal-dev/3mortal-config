#!/bin/bash

source "$CONFIG_DIR/colors.sh" # Loads all defined colors

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
# Floating, moody bar: slight margin off the screen edges (also gives the
# shadow room to render), soft rounded corners, a hairline border one shade
# lighter than the fill, and a heavier blur paired with a translucent
# BAR_COLOR (see colors.sh) so your wallpaper shows through underneath it -
# closer to the native macOS menu bar's vibrancy effect than a flat block.

sketchybar --bar height=34          \
                 margin=8           \
                 y_offset=6         \
                 corner_radius=12   \
                 blur_radius=50     \
                 border_width=0     \
                 shadow=off         \
                 position=top       \
                 sticky=off         \
                 padding_left=8     \
                 padding_right=8    \
                 color=$BAR_COLOR

##### Changing Defaults #####
# Slightly more generous padding than before so icons/labels stop feeling
# cramped, and a smaller, tighter pill height that matches the thinner bar.

sketchybar --default icon.font="SF Pro:Semibold:13.0"  \
                     icon.color=$WHITE                  \
                     label.font="SF Pro:Semibold:13.0"  \
                     label.color=$WHITE                 \
                     background.color=$ITEM_BG_COLOR     \
                     background.corner_radius=7           \
                     background.height=24                 \
                     background.border_width=0            \
                     padding_left=6                       \
                     padding_right=6                       \
                     label.padding_left=4                  \
                     label.padding_right=10                \
                     icon.padding_left=9                   \
                     icon.padding_right=4

# -- Left Side Items --
source $ITEM_DIR/fullscreen_watcher.sh
source $ITEM_DIR/spaces.sh
source $ITEM_DIR/separator.sh
source $ITEM_DIR/front_app.sh

# -- Right Side Of Notch Items --
source $ITEM_DIR/media.sh

# -- Center Items --
source $ITEM_DIR/mode_indicator.sh
source $ITEM_DIR/window_title.sh

# -- Right Side Items --
source $ITEM_DIR/keyboard.sh
source $ITEM_DIR/calendar.sh
source $ITEM_DIR/cpu.sh
source $ITEM_DIR/volume.sh
source $ITEM_DIR/battery.sh
source $ITEM_DIR/system_bracket.sh


##### Finalizing Setup #####
sketchybar --update
